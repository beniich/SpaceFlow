{
  "name": "cafm-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=cafm-frontend\" \"npm run dev --workspace=cafm-backend\"",
    "build": "npm run build --workspace=cafm-frontend",
    "start": "npm run start --workspace=cafm-backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "turbo": "^2.10.11"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dexie": "^4.4.5",
    "firebase": "^12.17.1",
    "framer-motion": "^12.43.0",
    "html5-qrcode": "^2.3.8",
    "qrcode.react": "^4.2.0",
    "react-chartjs-2": "^5.3.1",
    "uuid": "^14.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
