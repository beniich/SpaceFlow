// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgisExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================
// AUTH & MULTI-TENANT
// ============================================

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  status       TenantStatus @default(ACTIVE)
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  users        User[]
  assets       Asset[]
  bimModels    BIMModel[]
  bimElements  BIMElement[]
  sensors      Sensor[]
  alerts       Alert[]
  
  @@index([slug])
  @@index([status])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String
  passwordHash String
  fullName     String?
  role         UserRole @default(MEMBER)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  sessions     Session[]
  apiKeys      ApiKey[]
  acknowledgedAlerts Alert[] @relation("AcknowledgedBy")
  dismissedAlerts    Alert[] @relation("DismissedBy")
  
  @@unique([email, tenantId])
  @@index([tenantId])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  DEMO
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// BIM MODELS
// ============================================

model BIMModel {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  originalFilename String?
  storageKey       String   // S3 key
  fileSize         BigInt?
  fileHash         String?  // SHA256 pour déduplication
  status           BIMStatus @default(PROCESSING)
  elementCount     Int       @default(0)
  buildingId       String?
  building         Building? @relation(fields: [buildingId], references: [id])
  coordinateSystem String?  // e.g., "EPSG:4326"
  units            String?  // e.g., "meters"
  
  // Métadonnées traitement
  extractionDurationMs Int?
  errorMessage     String?
  errorAt          DateTime?
  processedAt      DateTime?
  
  // Stats usage
  lastViewedAt     DateTime?
  viewCount        Int       @default(0)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  
  elements         BIMElement[]
  alerts           Alert[]
  
  @@unique([tenantId, fileHash])
  @@index([tenantId, status])
  @@index([buildingId])
  @@index([deletedAt])
}

enum BIMStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
  ARCHIVED
}

model BIMElement {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modelId         String
  model           BIMModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  expressID       Int      // IFC express ID
  ifcGlobalId     String   // IFC GUID
  ifcType         String   // IFCBUILDING, IFCEQUIPMENT, etc.
  elementType     BIMElementType  // Catégorie simplifiée
  
  name            String?
  description     String?
  level           String?  // Ex: "L2"
  
  parentExpressID Int?     // Pour la hiérarchie
  geometry        Json?    // Bounding box, mesh simplifié
  properties      Json?    // PropertySets IFC
  boundingBox     Json?
  metadata        Json?    // Autres metadata (color, material...)
  
  // Liaison GMAO
  assetId         String?
  asset           Asset?   @relation(fields: [assetId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  
  @@unique([modelId, expressID])
  @@index([tenantId])
  @@index([modelId])
  @@index([ifcGlobalId])
  @@index([assetId])
  @@index([elementType])
  @@index([parentExpressID])
  @@index([deletedAt])
}

enum BIMElementType {
  SITE
  BUILDING
  FLOOR
  SPACE
  ZONE
  ASSET
  STRUCTURE
  OTHER
}

// ============================================
// ASSETS & WORK ORDERS
// ============================================

model Asset {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            AssetType
  status          AssetStatus @default(OPERATIONAL)
  
  // Hiérarchie
  parentId        String?
  parent          Asset?   @relation("AssetHierarchy", fields: [parentId], references: [id])
  children        Asset[]  @relation("AssetHierarchy")
  
  // Localisation
  buildingId      String?
  building        Building? @relation(fields: [buildingId], references: [id])
  floor           Int?
  zone            String?
  location        Json?    // {lat, lng} PostGIS
  
  // Caractéristiques
  criticality     Int      @default(3) // 1-5
  healthScore     Float?   // 0-100
  manufacturer    String?
  model           String?
  serialNumber    String?
  installDate     DateTime?
  warrantyEndDate DateTime?
  
  // Link IFC bidirectionnel
  ifcGuid         String?  @unique
  bimElements     BIMElement[]
  
  sensors         Sensor[]
  workOrders      WorkOrder[]
  maintenanceLogs MaintenanceLog[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastMaintenanceAt DateTime?
  deletedAt       DateTime?
  
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([parentId])
  @@index([buildingId])
  @@index([type])
  @@index([deletedAt])
}

enum AssetType {
  EQUIPMENT
  SYSTEM
  COMPONENT
  SPACE
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  ALERT
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

model Building {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  address      String?
  city         String?
  country      String?
  geoLocation  Json?    // PostGIS Point
  totalSurface Float?
  
  assets       Asset[]
  bimModels    BIMModel[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  
  @@index([tenantId])
  @@index([deletedAt])
}

model WorkOrder {
  id           String   @id @default(uuid())
  tenantId     String
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id])
  title        String
  description  String?
  type         WorkOrderType
  status       WorkOrderStatus @default(OPEN)
  priority     WorkOrderPriority @default(NORMAL)
  
  // Planification
  dueDate      DateTime?
  scheduledAt  DateTime?
  estimatedDuration Int? // minutes
  actualDuration   Int? // minutes
  
  // Assignation
  assigneeId   String?
  createdById  String
  
  // Résolution
  completedAt  DateTime?
  completedBy  String?
  
  // Coûts
  laborCost    Float?
  partsCost    Float?
  totalCost    Float?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([assigneeId])
  @@index([assetId])
  @@index([deletedAt])
}

enum WorkOrderType { PREVENTIVE CORRECTIVE EMERGENCY INSPECTION REQUEST }
enum WorkOrderStatus { OPEN IN_PROGRESS ON_HOLD COMPLETED CANCELLED }
enum WorkOrderPriority { LOW NORMAL HIGH URGENT }

model MaintenanceLog {
  id             String   @id @default(uuid())
  tenantId       String
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  
  workOrderId    String?
  type           MaintenanceType
  performedAt    DateTime @default(now())
  completedAt    DateTime
  technicianId   String
  technicianName String
  
  notes          String?
  beforePhotos   String[] // S3 keys
  afterPhotos    String[]
  signatureUrl   String?
  
  partsReplaced  Json?    // [{partId, quantity, cost}]
  laborHours     Float?
  totalCost      Float?
  
  createdAt      DateTime @default(now())
  
  @@index([tenantId, assetId])
  @@index([assetId])
  @@index([performedAt])
}

enum MaintenanceType { PREVENTIVE CORRECTIVE PREDICTIVE INSPECTION CALIBRATION }

// ============================================
// IOT / SENSORS
// ============================================

model Sensor {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  code            String
  name            String
  type            SensorType
  unit            String   // °C, kWh, m/s...
  status          SensorStatus @default(ACTIVE)
  protocol        String?  // MQTT, BACnet, Modbus...
  
  position        Json?    // {x, y, z} localisation dans asset
  metadata        Json?
  
  lastReadingAt   DateTime?
  lastReadingValue Float?
  
  readings        SensorReading[]
  thresholds      SensorThreshold?
  alerts          Alert[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  
  @@unique([tenantId, code])
  @@index([tenantId, assetId])
  @@index([type])
  @@index([status])
  @@index([lastReadingAt])
}

enum SensorType {
  TEMPERATURE
  HUMIDITY
  PRESSURE
  VIBRATION
  ENERGY
  FLOW
  CO2
  AIR_QUALITY
  LEVEL
  CURRENT
  VOLTAGE
  CUSTOM
}

enum SensorStatus {
  ACTIVE
  INACTIVE
  FAULTY
  CALIBRATING
  RETIRED
}

model SensorReading {
  id          BigInt   @id @default(autoincrement())
  tenantId    String
  sensorId    String
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  
  value       Float
  quality     DataQuality @default(GOOD)
  rawValue    Json?    // Données brutes si nécessaire
  timestamp   DateTime
  
  createdAt   DateTime @default(now())
  
  @@index([sensorId, timestamp(sort: Desc)])
  @@index([tenantId, timestamp(sort: Desc)])
  @@map("sensor_readings")
}

enum DataQuality { GOOD DEGRADED BAD OUTLIER }

model SensorThreshold {
  id          String   @id @default(uuid())
  sensorId    String   @unique
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  
  minValue    Float?
  maxValue    Float?
  minCritical Float?
  maxCritical Float?
  
  hysteresis  Float    @default(2.0) // Hysteresis pour éviter alertes flapping
  
  setBy       String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// ALERTS (système générique)
// ============================================

model Alert {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modelId         String?
  model           BIMModel? @relation(fields: [modelId], references: [id])
  sensorId        String?
  sensor          Sensor?   @relation(fields: [sensorId], references: [id])
  assetId         String?
  
  severity        AlertSeverity
  title           String
  description     String?
  location        String?  // "Floor L3 · Structural"
  
  value           Float?
  threshold       Float?
  
  acknowledgedAt  DateTime?
  acknowledgedById String?
  acknowledgedBy  User?    @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  
  dismissedAt     DateTime?
  dismissedById   String?
  dismissedBy     User?    @relation("DismissedBy", fields: [dismissedById], references: [id])
  dismissedReason String?
  
  resolvedAt      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, severity])
  @@index([modelId])
  @@index([sensorId])
  @@index([acknowledgedAt])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
  EMERGENCY
}

// ============================================
// ERP, CRM, LEASES (extraits)
// ============================================

model ApiKey {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  prefix      String   @unique // "pk_live_abc..."
  hash        String   // bcrypt du secret complet
  scopes      String[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  
  @@index([tenantId])
}

// ============================================
// LEASES / REAL ESTATE
// ============================================

model Lease {
  id          String   @id @default(uuid())
  tenantId    String
  buildingId  String?
  unit        String?
  startDate   DateTime
  endDate     DateTime
  rentAmount  Float
  currency    String   @default("EUR")
  status      String   @default("ACTIVE")
  terms       Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([endDate])
}

// ============================================
// AUDIT & EVENTS
// ============================================

model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?
  userId      String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN...
  resource    String   // "Asset", "WorkOrder"...
  resourceId  String?
  metadata    Json?
  ip          String?
  userAgent   String?
  timestamp   DateTime @default(now())
  
  @@index([tenantId, timestamp(sort: Desc)])
  @@index([resource, resourceId])
  @@index([userId])
}

// ============================================
// DEMO SESSION MANAGEMENT
// ============================================

model DemoSession {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  ipAddress    String
  userAgent    String?
  startedAt    DateTime @default(now())
  expiresAt    DateTime
  actionsCount Int      @default(0)
  metadata     Json?
  
  @@index([ipAddress, startedAt])
  @@index([expiresAt])
}
