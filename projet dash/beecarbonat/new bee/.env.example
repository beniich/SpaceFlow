# ==============================================================================
# BEECARBONIT - ENV VARIABLES TEMPLATE
# ==============================================================================
# ⚠️ ATTENTION : Ne jamais commiter le fichier .env en production
# Copiez ce fichier vers `.env` et remplissez les valeurs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & SERVER
# ------------------------------------------------------------------------------
# Port d'écoute de l'API (défaut: 5000)
PORT=5000
# URL de l'API Backend pour le Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
# URL du Frontend pour la configuration des webhooks/redirections
FRONTEND_URL=http://localhost:3000
# Mode d'exécution (development, production)
NODE_ENV=development
# Niveau de log (debug, info, warn, error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES (PostgreSQL via Prisma / Neon)
# ------------------------------------------------------------------------------
# URL de connexion principale
DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"
# URL de la base de données shadow (nécessaire pour les migrations Prisma cloud)
SHADOW_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTIFICATION & SÉCURITÉ
# ------------------------------------------------------------------------------
# Clé secrète pour signer les JWT (CRITIQUE : utiliser une longue chaîne aléatoire)
JWT_SECRET=votre_secret_jwt_hyper_long
# Durée de validité des tokens
JWT_EXPIRES_IN=7d
# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. STRIPE (Billing)
# ------------------------------------------------------------------------------
# Clé secrète API Stripe (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=
# Clé publique API Stripe (pk_test_... ou pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret pour vérifier les signatures Webhook Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Price IDs pour les différents plans d'abonnement
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ------------------------------------------------------------------------------
# 5. AWS S3 (Uploads fichiers)
# ------------------------------------------------------------------------------
# Région AWS (ex: eu-west-3)
AWS_REGION=eu-west-3
# Clé d'accès AWS
AWS_ACCESS_KEY_ID=
# Clé secrète AWS
AWS_SECRET_ACCESS_KEY=
# Nom du bucket S3
AWS_S3_BUCKET=beecarbonit-uploads

# ------------------------------------------------------------------------------
# 6. OBSERVABILITÉ (Sentry)
# ------------------------------------------------------------------------------
# DSN Sentry pour capter les erreurs Frontend
VITE_SENTRY_DSN=
# DSN Sentry pour le Backend (optionnel)
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 7. INTELLIGENCE ARTIFICIELLE
# ------------------------------------------------------------------------------
# Clé API Google Gemini (Aether AI)
GEMINI_API_KEY=
# Clé API OpenAI (Fallback RAG)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 8. SERVICES EXTERNES & DIVERS
# ------------------------------------------------------------------------------
# REDIS (Files d'attente BullMQ, Cache)
REDIS_URL=redis://localhost:6379
# Envoi d'emails (Resend / SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=