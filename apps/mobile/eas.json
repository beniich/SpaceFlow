{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "base": {
      "node": "20.0.0",
      "yarn": "1.22.22",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beecarbonat.ricecloud.net/api"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:5000"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beecarbonat.ricecloud.net/api"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": "buildNumber",
      "ios": {
        "resourceClass": "m1-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beecarbonat.ricecloud.net/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "apple-dev@beecarbonat.com",
        "ascAppId": "YOUR_ASC_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
