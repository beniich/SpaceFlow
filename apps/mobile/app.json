{
  "expo": {
    "name": "BeeCarbonat",
    "slug": "beecarbonat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.beecarbonat.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "BeeCarbonat utilise la caméra pour scanner les QR codes des équipements et capturer des photos.",
        "NSLocationWhenInUseUsageDescription": "BeeCarbonat utilise votre position pour géolocaliser les interventions.",
        "NSFaceIDUsageDescription": "BeeCarbonat utilise Face ID pour sécuriser votre compte.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "io.beecarbonat.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "BeeCarbonat a besoin de la caméra pour scanner les QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BeeCarbonat utilise votre position pour géolocaliser les interventions."
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-store-review",
      "sentry-expo"
    ],
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiUrl": "https://beecarbonat.ricecloud.net/api",
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
